<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title</title>

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/Css/admin.css" />
</head>

<body class="bg-light">

    <!-- ================= TOP NAVBAR ================= -->

    <nav class="navbar navbar-expand-lg sticky-top"
         style="background:#ffffff;
            border-bottom:1px solid #e5e7eb;
            padding:12px 24px;
            box-shadow:0 10px 30px rgba(0,0,0,.06);">

        <!-- LEFT -->
        <div class="d-flex align-items-center gap-3">
            <button class="btn d-lg-none"
                    data-bs-toggle="collapse"
                    data-bs-target="#sidebar">
                <i class="bi bi-list fs-3 text-primary"></i>
            </button>

            <span style="
            font-size:20px;
            font-weight:900;
            letter-spacing:.6px;
            color:#111827;">
                🛒 SHOP ADMIN
            </span>
        </div>

        <!-- RIGHT -->
        <div class="dropdown ms-auto">
            <a href="#"
               data-bs-toggle="dropdown"
               class="d-flex align-items-center gap-2 text-decoration-none"
               style="font-weight:700;color:#111827;">

                <i class="bi bi-person-circle fs-3 text-primary"></i>
                Admin
            </a>

            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 mt-2">
                <li>
                    <a class="dropdown-item fw-semibold py-2"
                       href="@Url.Action("Profile", "Admin")">
                        <i class="bi bi-person me-2 text-primary"></i>
                        Profile
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item fw-semibold py-2 text-danger"
                       href="@Url.Action("Admin_Logout", "Admin")">
                        <i class="bi bi-box-arrow-right me-2"></i>
                        Logout
                    </a>
                </li>
            </ul>
        </div>

    </nav>

    <!-- ================= MAIN LAYOUT ================= -->

    <div class="container-fluid">
        <div class="row">

            <!-- ========== SIDEBAR ========== -->
                
            <div id="sidebar"
                 class="col-12 col-md-3 col-lg-2 d-lg-block collapse"
                 style="min-height:100vh;
            background:#ffffff;
            border-right:1px solid #e5e7eb;
            padding-top:24px;">

                <!-- BRAND -->
                <div class="text-center mb-4">
                    <i class="bi bi-cart-check-fill"
                       style="font-size:40px;color:#2563eb;"></i>

                    <div style="font-size:18px;
                    font-weight:800;
                    letter-spacing:.6px;
                    color:#111827;">
                        ADMIN PANEL
                    </div>
                </div>

                <!-- MENU -->
                <ul class="nav flex-column px-3 gap-3">

                    <!-- ACTIVE ITEM -->
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Admin")"
                           class="d-flex align-items-center gap-3 rounded-4 text-decoration-none"
                           style="padding:14px 18px;
                      font-size:15px;
                      font-weight:800;
                      color:#2563eb;
                      background:#eff6ff;
                      box-shadow:0 8px 22px rgba(37,99,235,.18);">
                            <i class="bi bi-house-door-fill fs-5"></i>
                            Dashboard
                        </a>
                    </li>

                    <!-- NORMAL ITEMS -->

                    @foreach (var item in new[]{
                                        new {Icon="person-fill",Text="Profile",Url=Url.Action("Profile","Admin")},
                                        new {Icon="people-fill",Text="Customers",Url=Url.Action("fetchCustomer","Admin")},
                                        new {Icon="tags-fill",Text="Categories",Url=Url.Action("FetchCategory","Admin")},
                                        new {Icon="box-seam-fill",Text="Products",Url=Url.Action("FetchProduct","Admin")},
                                        new {Icon="bag-check-fill",Text="Orders",Url=Url.Action("FetchOrders","Admin")},
                                        new {Icon="bag-check-fill",Text="Feedbacks",Url=Url.Action("Feedback","Admin")},

                                        })
                    {
                        <li class="nav-item">
                            <a href="@item.Url"
                               class="d-flex align-items-center gap-3 rounded-4 text-decoration-none"
                               style="padding:14px 18px;
                          font-size:14.5px;
                          font-weight:700;
                          color:#374151;
                          transition:.25s;"
                               onmouseover="
                        this.style.background='#f1f5f9';
                        this.style.transform='translateX(6px)';
                        this.style.boxShadow='0 4px 16px rgba(0,0,0,.08)';
                   "
                               onmouseout="
                        this.style.background='transparent';
                        this.style.transform='translateX(0)';
                        this.style.boxShadow='none';
                   ">
                                <i class="bi bi-@item.Icon"
                                   style="font-size:18px;color:#2563eb;"></i>
                                @item.Text
                            </a>
                        </li>
                    }

                </ul>
            </div>




            <!-- ========== MAIN CONTENT ========== -->

            <main class="col-12 col-md-9 col-lg-10 p-4">
                @RenderBody()
            </main>

        </div>
    </div>

    <!-- ================= FOOTER ================= -->
    <footer style="
    background:#ffffff;
    border-top:1px solid #e5e7eb;
    padding:16px 0;
    margin-top:auto;
    box-shadow:0 -8px 20px rgba(0,0,0,.05);">

        <div class="container text-center">
            <span style="
            font-size:13.5px;
            font-weight:600;
            color:#6b7280;">
                © 2026 Shopping Cart Admin Panel — All Rights Reserved
            </span>
        </div>

    </footer>


    <!-- Bootstrap JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>
