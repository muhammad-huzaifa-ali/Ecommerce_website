<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>User Auth</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            min-height: 100vh;
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, rgba(15,23,42,0.85), rgba(30,41,59,0.85)), url('https://images.unsplash.com/photo-1522202176988-66273c2fd55f?q=80&w=2070');
            background-size: cover;
            background-position: center;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 15px; /* 🔥 TOP & BOTTOM SPACE */
        }


        /*  Glass Card */
        .auth-wrapper {
            width: 100%;
            max-width: 520px;
        }


        .card {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border-radius: 25px;
            border: 1px solid rgba(255,255,255,0.2);
            box-shadow: 0 25px 45px rgba(0,0,0,0.4);
            color: #fff;
        }

        h3 {
            font-weight: 700;
            letter-spacing: 1px;
        }

        /* ✨ Inputs */
        .form-control,
        .form-select {
            background: rgba(255,255,255,0.15);
            border: 1px solid rgba(255,255,255,0.2);
            color: #fff;
            border-radius: 12px;
        }

            .form-control::placeholder {
                color: #ddd;
            }

            .form-control:focus,
            .form-select:focus {
                background: rgba(255,255,255,0.25);
                box-shadow: 0 0 0 2px rgba(255,180,0,0.6);
                color: #fff;
            }

        label {
            font-size: 13px;
            margin-bottom: 5px;
        }

        /* 🚀 VIP Button */
        .btn-primary {
            background: linear-gradient(45deg, #ffb400, #ff7b00);
            border: none;
            font-weight: 600;
            border-radius: 30px;
            padding: 10px;
            transition: 0.3s ease;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 20px rgba(255,123,0,0.4);
            }

        a {
            color: #ffb400;
            text-decoration: none;
        }

            a:hover {
                text-decoration: underline;
            }

        /* 🎯 Smooth Animation */
        .card {
            animation: fadeIn 0.8s ease-in-out;
        }

        @@keyframes fadeIn {
            from

        {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        @@media (max-width: 576px) {
            body

        {
            align-items: flex-start; /* mobile pe upar se start */
            padding: 30px 10px;
        }

        .card {
            border-radius: 18px;
        }

        .card-body {
            padding: 25px !important;
        }

        }
    </style>
</head>

<body>
    <div class="auth-wrapper">
        @RenderBody()
    </div>
</body>
</html>
