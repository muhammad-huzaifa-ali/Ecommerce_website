 <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap + Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">


</head>

<body class="d-flex flex-column min-vh-100 bg-light">


    <!-- ================= TOP INFO BAR ================= -->

    <div class="top-bar text-light">
        <div class="container d-flex flex-wrap justify-content-between align-items-center small">

            <div class="d-flex flex-wrap gap-3 gap-md-4 align-items-center mb-2 mb-md-0">
                <span><i class="bi bi-telephone-fill text-warning"></i> 0300-1234564</span>
                <span><i class="bi bi-envelope-fill text-warning"></i> support@techora.com</span>
            </div>

            <div class="d-flex align-items-center gap-2 gap-md-3">
                <span class="badge bg-warning text-dark fw-semibold px-2 px-md-3 py-1">
                    Free Delivery over Rs.5000
                </span>
            </div>

        </div>
    </div>



    <!-- ================= MAIN HEADER ================= -->
    <header class="main-header py-3">
        <div class="container">
            <div class="header-row d-flex align-items-center justify-content-between">

                <!-- LOGO -->
                <div class="d-flex align-items-center gap-3 logo-section">
                    <div class="logo-icon">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </div>
                    <div class="lh-1">
                        <div class="fw-bold fs-3 brand-name">
                            Techora
                        </div>
                        <small class="brand-tagline">
                            SMART TECH STORE
                        </small>
                    </div>
                </div>

                <!-- SEARCH -->
                <form asp-controller="User" asp-action="Shop" method="get" class="search-form mx-3">
                    <input type="text" name="searchTerm" placeholder="Search for gadgets, accessories..."
                           value='@Context.Request.Query["searchTerm"]' />
                    <button type="submit"><i class="bi bi-search"></i></button>
                </form>

                <!-- ACCOUNT + CART + ORDERS -->
                <div class="header-icons d-flex align-items-center gap-4">

                    <!-- ACCOUNT -->
                    <div class="dropdown account-dropdown">
                        <a href="#" class="d-flex align-items-center gap-2 dropdown-toggle" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle fs-4"></i>
                            <span class="fw-semibold">Account</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 mt-3">
                            @if (Context.Session.GetString("User_Session") == null)
                            {
                                <li>
                                    <a class="dropdown-item fw-semibold" asp-controller="User" asp-action="SignIn">
                                        <i class="bi bi-box-arrow-in-right me-2"></i> Sign In
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item fw-semibold" asp-controller="User" asp-action="SignUp">
                                        <i class="bi bi-person-plus me-2"></i> Sign Up
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a class="dropdown-item fw-semibold" asp-controller="User" asp-action="Profile">
                                        <i class="bi bi-person me-2"></i> My Profile
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="User" asp-action="EditCustomer">
                                        <i class="bi bi-pencil-square me-2"></i> Edit Profile
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item fw-semibold text-danger" asp-controller="User" asp-action="Logout">
                                        <i class="bi bi-box-arrow-right me-2"></i> Logout
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    <!-- CART -->
                    <div class="vip-icon text-center">
                        <a asp-controller="User" asp-action="CartPage">
                            <i class="bi bi-cart-fill vip-icon-white"></i>
                            <div class="vip-text">Cart</div>
                        </a>
                    </div>

                    <!-- ORDERS -->
                    <div class="vip-icon text-center">
                        <a asp-controller="User" asp-action="FetchOrders">
                            <i class="bi bi-bag-check-fill vip-icon-white"></i>
                            <div class="vip-text">Orders</div>
                        </a>
                    </div>

                </div>

            </div>
        </div>
    </header>


    <!-- ================= NAVBAR ================= -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
        <div class="container">

            <!-- TOGGLE BUTTON (MOBILE) -->
            <button class="navbar-toggler border-0"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- NAV LINKS -->
            <div class="collapse navbar-collapse justify-content-center" id="mainNavbar">
                <ul class="navbar-nav gap-lg-4 text-center fw-semibold">

                    <li class="nav-item">
                        <a class="nav-link active" href="@Url.Action("Index", "User")">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("AboutUs", "User")">
                            About Us
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Shop", "User")">
                            Shop
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Experience", "User")">
                            Experience
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("ContactUs", "User")">
                            Contact
                        </a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>


    <!-- ================= MAIN CONTENT ================= -->
    <main class="flex-grow-1 py-5">
        @RenderBody()
    </main>

    <!-- ================= FOOTER ================= -->


    <footer class="footer-vip text-light mt-auto">
        <div class="container py-5">

            <div class="row g-4">

                <!-- BRAND -->
                <div class="col-md-4">
                    <h4 class="fw-bold text-warning mb-2">
                        <i class="bi bi-lightning-charge-fill me-1"></i> Techora
                    </h4>
                    <p class="small text-secondary lh-lg">
                        Your one-stop premium tech marketplace.<br />
                        Quality gadgets • Trusted brands • Fast delivery.
                    </p>
                </div>

                <!-- QUICK LINKS -->
                <div class="col-md-2">
                    <h6 class="fw-semibold mb-3">Quick Links</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a href="#">Home</a></li>
                        <li><a href="#">Shop</a></li>
                        <li><a href="#">Collections</a></li>
                        <li><a href="#">Contact</a></li>
                    </ul>
                </div>

                <!-- ACCOUNT -->
                <div class="col-md-3">
                    <h6 class="fw-semibold mb-3">My Account</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a href="#">Sign In</a></li>
                        <li><a href="#">Register</a></li>
                        <li><a href="#">My Orders</a></li>
                        <li><a href="#">Cart</a></li>
                    </ul>
                </div>

                <!-- SOCIAL -->
                <div class="col-md-3">
                    <h6 class="fw-semibold mb-3">Follow Us</h6>
                    <div class="d-flex gap-3 fs-4 footer-social">
                        <i class="bi bi-facebook"></i>
                        <i class="bi bi-instagram"></i>
                        <i class="bi bi-twitter-x"></i>
                        <i class="bi bi-youtube"></i>
                    </div>
                </div>

            </div>

            <hr class="border-secondary my-4">

            <div class="text-center small text-secondary">
                © 2026 <span class="text-warning fw-semibold">Techora</span>. All rights reserved.
            </div>

        </div>
    </footer>

    

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        /* ===== TOP BAR ===== */
        .top-bar {
            background: linear-gradient(90deg, #0f0f0f, #1c1c1c);
            padding: 6px 0;
            color: #fff;
        }

            .top-bar .bi {
                font-size: 14px;
            }

        /* Adjust font size and padding on small screens */
        @@media (max-width: 576px) {
            .top-bar

        {
            font-size: 12px;
            text-align: center;
        }

        .top-bar .d-flex {
            justify-content: center !important;
        }

        .top-bar .badge {
            font-size: 10px;
            padding: 2px 6px !important;
        }

        .top-bar span {
            display: block;
            margin-bottom: 4px;
        }

        }

        .auth-links a {
            color: #fff;
            text-decoration: none;
            font-weight: 500;
        }

            .auth-links a:hover {
                color: #ffc107;
            }




        /* ===== HEADER ===== */
        .main-header {
            background: #111;
            padding: 12px 0;
            color: #fff;
        }

        /* ===== HEADER ROW FLEX ===== */
        .header-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: nowrap;
            gap: 20px;
        }

        /* ===== LOGO ===== */
        .logo-icon {
            width: 45px;
            height: 45px;
            background: #ffc107;
            color: #000;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            font-size: 22px;
        }

        .brand-name {
            letter-spacing: 1.5px;
            font-weight: bold;
            color: #fff;
        }

        .brand-tagline {
            font-size: 12px;
            letter-spacing: 1px;
            opacity: 0.7;
            color: #fff;
        }

        /* ===== SEARCH FORM ===== */
        .search-form {
            flex: 1;
            display: flex;
            max-width: 600px;
        }

            .search-form input {
                flex: 1;
                padding: 10px 16px;
                border-radius: 30px 0 0 30px;
                border: 1px solid #ccc;
                outline: none;
            }

            .search-form button {
                border: none;
                padding: 10px 18px;
                border-radius: 0 30px 30px 0;
                background: #ffc107;
                color: #000;
                font-size: 18px;
                cursor: pointer;
                transition: 0.3s;
            }

                .search-form button:hover {
                    background: #e6b800;
                }

        /* ===== ACCOUNT + VIP ICONS ===== */
        .header-icons {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        /* VIP ICONS */
        .vip-icon a {
            text-decoration: none;
            color: #fff;
            display: flex;
            flex-direction: column;
            align-items: center;
            font-size: 24px;
            transition: 0.3s;
        }

        .vip-icon:hover a {
            color: #ffc107;
            transform: scale(1.1);
        }

        .vip-text {
            font-size: 12px;
            font-weight: 600;
            margin-top: 4px;
        }

        /* ACCOUNT DROPDOWN */
        .account-dropdown > a {
            color: #fff;
            text-decoration: none;
            font-weight: 600;
        }

            .account-dropdown > a:hover {
                color: #ffc107;
            }

        /* ===== RESPONSIVE ===== */
        @@media (max-width: 992px) {
            .header-row

        {
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px;
        }

        .search-form {
            max-width: 100%;
        }

        .account-dropdown > a span {
            display: none; /* hide Account text on mobile */
        }

        }



        /* ===== NAVBAR ===== */

        .navbar {
            background: #ffffff;
            position:sticky;
        }

        .navbar-nav .nav-link {
            color: #111;
            font-weight: 600;
            letter-spacing: .6px;
            padding: 10px 0;
            position: relative;
            transition: .3s ease;
        }

            /* Hover underline */
            .navbar-nav .nav-link::after {
                content: "";
                position: absolute;
                left: 0;
                bottom: -6px;
                width: 0;
                height: 2px;
                background: #ffc107;
                transition: .3s ease;
            }

            .navbar-nav .nav-link:hover {
                color: #ffc107;
            }

                .navbar-nav .nav-link:hover::after,
                .navbar-nav .nav-link.active::after {
                    width: 100%;
                }

            /* Active link */
            .navbar-nav .nav-link.active {
                color: #ffc107;
            }

        /* Mobile toggle */
        .navbar-toggler:focus {
            box-shadow: none;
        }

 

        /* =====  FOOTER ===== */

        .footer-vip {
            background: linear-gradient(180deg, #111, #000);
        }

        /* Links */
        .footer-links li {
            margin-bottom: 8px;
        }

        .footer-links a {
            color: #9ca3af;
            text-decoration: none;
            transition: .3s ease;
        }

            .footer-links a:hover {
                color: #ffc107;
                padding-left: 6px;
            }

        /* Social icons */
        .footer-social i {
            color: #9ca3af;
            cursor: pointer;
            transition: .3s ease;
        }

            .footer-social i:hover {
                color: #ffc107;
                transform: translateY(-4px);
            }


    </style>



</body>

</html>





