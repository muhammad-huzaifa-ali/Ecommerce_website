@model Ecommerce_website.Models.Category

@{
    Layout = "_Dashboard";
    ViewData["Title"] = "Edit Category";
}

<style>
    .vip-card {
        border-radius: 18px;
    }

    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 .15rem rgba(13,110,253,.25);
    }
</style>

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-6">

            <div class="card vip-card shadow-lg border-0">
                <div class="card-body p-4">

                    <h4 class="fw-bold text-primary mb-3">
                        Edit Category
                    </h4>

                    <!-- SUCCESS MESSAGE -->
                    @if (TempData["message"] != null)
                    {
                        <div id="alertBox"
                             class="alert alert-success d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>@TempData["message"]</span>
                        </div>
                    }

                    <!-- ERROR SUMMARY -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div id="errorBox" class="alert alert-danger">
                            <strong>Please fix the following errors:</strong>
                            <ul class="mb-0 mt-2">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                    <!-- FORM -->
                    <form asp-action="EditCategory" asp-controller="Admin" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="category_id" />

                        <div class="mb-4">
                            <label asp-for="category_name" class="form-label fw-semibold">
                                Category Name
                            </label>

                            <input asp-for="category_name"
                                   class="form-control form-control-lg"
                                   placeholder="e.g. Electronics, Fashion" />

                            <span asp-validation-for="category_name"
                                  class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-primary px-4 fw-semibold shadow-sm">
                                <i class="bi bi-save"></i> Update
                            </button>

                            <a asp-action="FetchCategory"
                               class="btn btn-outline-secondary px-4">
                                Back
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        setTimeout(function () {
            let alertBox = document.getElementById("alertBox");
            let errorBox = document.getElementById("errorBox");

            if (alertBox) alertBox.style.display = "none";
            if (errorBox) errorBox.style.display = "none";
        }, 2500);
    </script>
}
