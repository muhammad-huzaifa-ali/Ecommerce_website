

@{
    Layout = "_Dashboard";
}

<style>
    .vip-card {
        border-radius: 18px;
        border: none;
        box-shadow: 0 10px 25px rgba(0,0,0,.08);
        transition: .3s;
    }

        .vip-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 40px rgba(0,0,0,.15);
        }

    .welcome-card {
        background: linear-gradient(135deg,#0d6efd,#4dabff);
        border-radius: 20px;
        position: relative;
        overflow: hidden;
    }

        .welcome-card i {
            position: absolute;
            right: 25px;
            top: 15px;
            font-size: 70px;
            opacity: .15;
        }

    .dash-box {
        background: #fff;
        border-radius: 16px;
        padding: 22px;
        box-shadow: 0 8px 18px rgba(0,0,0,.08);
        height: 100%;
        transition: .3s;
    }

        .dash-box:hover {
            transform: translateY(-6px);
        }

    .dash-icon {
        font-size: 30px;
        color: #0d6efd;
        margin-bottom: 10px;
    }

    .vip-title {
        font-weight: 700;
        font-size: 18px;
    }

    .activity-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid #eee;
    }

        .activity-item:last-child {
            border-bottom: none;
        }

    .circle-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0d6efd;
        color: #fff;
    }

    .tip-box {
        background: linear-gradient(135deg,#f8f9ff,#eef3ff);
        border-radius: 18px;
        padding: 22px;
    }

    /* QUICK ACTION BIG VIP */
    .quick-card {
        border-radius: 18px;
        padding-bottom: 8px;
        min-height: 150px; /* outer card height */
    }

        .quick-card .card-header {
            padding: 16px 20px;
            font-size: 16px;
            font-weight: 700;
        }

        .quick-card .card-body {
            padding: 25px 20px; /* inner space height */
        }

    /* BUTTON BIG */
    .action-btn {
        padding: 14px 22px;
        font-size: 15px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        font-weight: 600;
        transition: .3s;
    }

        .action-btn i {
            font-size: 18px;
        }

        .action-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,.15);
        }



</style>


<div class="container-fluid mt-4">

    <!--  WELCOME -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="welcome-card text-white">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="fw-bold mb-1">Admin Dashboard 👑</h3>
                        <p class="mb-0 opacity-75">Manage your store smartly & quickly</p>
                    </div>
                    <i class="bi bi-speedometer2"></i>
                </div>
            </div>
        </div>
    </div>


    <!-- 🔥 ADMIN FEATURES -->
    <div class="row g-4 mb-4">

        <div class="col-lg-3 col-md-6">
            <div class="dash-box text-center">
                <div class="dash-icon"><i class="bi bi-box-seam"></i></div>
                <h6 class="fw-bold">Product Manager</h6>
                <small class="text-muted">Add & manage store products easily</small>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="dash-box text-center">
                <div class="dash-icon"><i class="bi bi-tags"></i></div>
                <h6 class="fw-bold">Category Control</h6>
                <small class="text-muted">Organize products by category</small>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="dash-box text-center">
                <div class="dash-icon"><i class="bi bi-people"></i></div>
                <h6 class="fw-bold">Customer Panel</h6>
                <small class="text-muted">View all registered users</small>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="dash-box text-center">
                <div class="dash-icon"><i class="bi bi-shield-check"></i></div>
                <h6 class="fw-bold">Admin Security</h6>
                <small class="text-muted">Full admin access control</small>
            </div>
        </div>

    </div>




    <!-- QUICK ACTION -->
    <div class="row g-4">

        <!-- QUICK ACTION CARD -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 quick-card">

                <div class="card-header bg-white fw-semibold d-flex align-items-center gap-2">
                    <i class="bi bi-lightning-charge-fill text-primary"></i>
                    Quick Actions
                </div>

                <div class="card-body d-flex gap-3 flex-wrap align-items-center">

                    <a href="@Url.Action("AddProduct", "Admin")"
                       class="btn btn-primary action-btn">
                        <i class="bi bi-plus-circle me-2"></i>
                        Add Product
                    </a>

                    <a href="@Url.Action("AddCategory", "Admin")"
                       class="btn btn-outline-primary action-btn">
                        <i class="bi bi-tags me-2"></i>
                        Add Category
                    </a>

                    <a href="@Url.Action("FetchCustomer", "Admin")"
                       class="btn btn-outline-dark action-btn">
                        <i class="bi bi-people me-2"></i>
                        Customers
                    </a>

                </div>
            </div>
        </div>



        <!-- ACTIVITY PANEL -->
        <div class="col-lg-6">
            <div class="card vip-card h-100">
                <div class="card-header bg-white vip-title">
                    🕒 Recent Activity
                </div>

                <div class="card-body">

                    <div class="activity-item">
                        <div class="circle-icon">
                            <i class="bi bi-box"></i>
                        </div>
                        <div>
                            <div class="fw-semibold">Product section ready</div>
                            <small class="text-muted">Manage products anytime</small>
                        </div>
                    </div>

                    <div class="activity-item">
                        <div class="circle-icon bg-success">
                            <i class="bi bi-people"></i>
                        </div>
                        <div>
                            <div class="fw-semibold">Customer module active</div>
                            <small class="text-muted">View all users easily</small>
                        </div>
                    </div>

                    <div class="activity-item">
                        <div class="circle-icon bg-dark">
                            <i class="bi bi-gear"></i>
                        </div>
                        <div>
                            <div class="fw-semibold">Admin panel secured</div>
                            <small class="text-muted">System running smoothly</small>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>



    <!--  ADMIN INFO BOX -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="tip-box">
                <h5 class="fw-bold mb-2">🚀 Admin Control Panel</h5>
                <p class="text-muted mb-0">
                    From this dashboard you can manage products, categories and customers easily.
                    Use quick actions for faster workflow and maintain your store regularly
                    for best performance.
                </p>
            </div>
        </div>
    </div>

</div>
