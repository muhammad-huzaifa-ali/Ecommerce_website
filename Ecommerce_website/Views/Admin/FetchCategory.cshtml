@model List<Ecommerce_website.Models.Category>
@{
    Layout = "_Dashboard";
}

<style>
    /* ===== Table polish ===== */
    .vip-table th {
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .vip-table tbody tr {
        transition: all .2s ease;
    }

        .vip-table tbody tr:hover {
            background-color: rgba(13,110,253,.04);
        }

    /* ===== Action buttons ===== */
    .action-btn {
        border: none;
        background: transparent;
        padding: 5px 7px;
        border-radius: 6px;
        transition: .2s;
    }

        .action-btn.edit {
            color: #0dcaf0;
        }

        .action-btn.delete {
            color: #dc3545;
        }

        .action-btn:hover {
            background: rgba(0,0,0,.05);
            transform: scale(1.1);
        }
</style>

<div class="container-fluid py-4">

    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <h5 class="fw-bold text-primary mb-0">
                    Categories
                </h5>

                <a href="@Url.Action("AddCategory", "Admin")"
                   class="btn btn-primary btn-sm fw-semibold shadow-sm">
                    <i class="bi bi-plus-lg"></i> Add Category
                </a>
            </div>

            <div class="table-responsive">
                <table class="table vip-table align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Category ID</th>
                            <th>Category Name</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int count = 1;
                        }

                        @foreach (var Cat in Model)
                        {
                            <tr>
                                <td>@count</td>

                                <td class="fw-semibold">
                                    @Cat.category_id
                                </td>

                                <td class="text-break">
                                    @Cat.category_name
                                </td>

                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">

                                        <a class="action-btn edit"
                                           title="Edit"
                                           href="@Url.Action("EditCategory", "Admin", new { id = Cat.category_id })">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>

                                        <a class="action-btn delete"
                                           title="Delete"
                                           href="@Url.Action("DeleteCategory", "Admin", new { id = Cat.category_id })"
                                           onclick="return confirm('Delete this category?')">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>

                                    </div>
                                </td>
                            </tr>
                            count++;
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
