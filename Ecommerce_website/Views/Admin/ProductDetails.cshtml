@model Ecommerce_website.Models.Product
@{
    Layout = "_Dashboard";
}

<div class="container py-4">
    <div class="card shadow border-0 rounded-4">
        <div class="card-body">

            <h4 class="fw-bold mb-4">Product Details</h4>

            <div class="row g-4">

                <div class="col-md-4 text-center">
                    <img src="~/Product_images/@Model.product_image"
                         class="img-fluid rounded-3 border"
                         style="max-height:250px; object-fit:cover;"
                         alt="Product Image" />
                </div>

                <div class="col-md-8">
                    <p><strong>Name:</strong> @Model.product_name</p>
                    <p><strong>Price:</strong> @Model.product_price</p>
                    <p><strong>Category:</strong> @Model.category.category_name</p>
                    <p><strong>Description:</strong><br />@Model.product_description</p>

                    <a asp-action="FetchProduct" class="btn btn-secondary mt-3">
                        Back
                    </a>
                </div>

            </div>

        </div>
    </div>
</div>
