@model Ecommerce_website.Models.Customer
@{
    Layout = "_Dashboard";
}

<style>
    .vip-card {
        border-radius: 18px;
        border: none;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 .15rem rgba(13,110,253,.25);
    }
</style>

<div class="container-fluid">
    <div class="row justify-content-center mt-4 mb-5">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">

            <div class="card vip-card shadow-lg p-4">
                <h3 class="fw-bold mb-4 text-center text-primary">
                    Edit Customer
                </h3>

                <!-- CUSTOMER IMAGE (VIEW ONLY) -->
                <div class="text-center mb-4">
                    <img src="~/Customer_images/@Model.customer_image"
                         class="rounded-circle border border-3 border-primary shadow-sm"
                         width="140"
                         height="140"
                         style="object-fit:cover;" />
                </div>

                <!-- EDIT FORM -->
                <form asp-action="EditCustomer" method="post">

                    <input type="hidden" asp-for="customer_id" />


                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Name</label>
                            <input asp-for="customer_name" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Phone</label>
                            <input asp-for="customer_phone" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Gender</label>
                            <select asp-for="customer_gender" class="form-select">
                                <option>Male</option>
                                <option>Female</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Country</label>
                            <input asp-for="customer_country" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">City</label>
                            <input asp-for="customer_city" class="form-control" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Address</label>
                            <textarea asp-for="customer_address"
                                      class="form-control"
                                      rows="3"></textarea>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit"
                                class="btn btn-primary fw-bold py-2 flex-fill shadow-sm">
                            Update Customer
                        </button>

                        <a asp-action="FetchCustomer"
                           class="btn btn-outline-secondary fw-bold py-2 flex-fill">
                            Back
                        </a>
                    </div>

                </form>
            </div>

        </div>
    </div>
</div>
