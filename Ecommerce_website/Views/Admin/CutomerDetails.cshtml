@model Ecommerce_website.Models.Customer
@{
    Layout = "_Dashboard";
}

<style>
    .vip-card {
        border-radius: 18px;
        border: none;
    }

    .detail-label {
        font-weight: 600;
        color: #6c757d;
        font-size: .85rem;
        text-transform: uppercase;
    }

    .detail-value {
        font-size: 1rem;
        font-weight: 500;
    }
</style>

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-7">

            <div class="card vip-card shadow-lg">
                <div class="card-body p-4">

                    <!-- HEADER -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="fw-bold text-primary mb-0">
                            Customer Details
                        </h4>

                        <a asp-action="fetchCustomer"
                           class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-arrow-left"></i> Back
                        </a>
                    </div>

                    <!-- PROFILE IMAGE -->
                    <div class="text-center mb-4">
                        <img src="~/Customer_images/@Model.customer_image"
                             asp-append-version="true"
                             class="rounded-circle border border-3 border-primary shadow-sm"
                             width="140"
                             height="140"
                             style="object-fit:cover;"
                             alt="Customer Image" />
                    </div>

                    <!-- DETAILS -->
                    <div class="row g-3">

                            <div class="col-md-6">
                                <div class="detail-label">Customer ID</div>
                                <div class="detail-value">@Model.customer_id</div>
                            </div>

                        <div class="col-md-6">
                            <div class="detail-label">Name</div>
                            <div class="detail-value">@Model.customer_name</div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-label">Email</div>
                            <div class="detail-value">@Model.customer_email</div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-label">Phone</div>
                            <div class="detail-value">@Model.customer_phone</div>
                        </div>


                        <div class="col-md-6">
                            <div class="detail-label">Gender</div>
                            <div class="detail-value">@Model.customer_gender</div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-label">Country</div>
                            <div class="detail-value">@Model.customer_country</div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-label">City</div>
                            <div class="detail-value">@Model.customer_city</div>
                        </div>

                        <div class="col-12">
                            <div class="detail-label">Address</div>
                            <div class="detail-value">@Model.customer_address</div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
