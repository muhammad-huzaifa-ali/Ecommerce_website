@{
    Layout = "~/Views/Shared/_UserAuthLayout.cshtml";
}

<div class="auth-card">
    <div class="card border-0">
        <div class="card-body p-5">

            <h3 class="text-center mb-4 fw-bold">
                Welcome Back
            </h3>

            @if (ViewBag.message != null)
            {
                <div class="alert alert-danger bg-danger bg-opacity-25 border-0 text-white">
                    @ViewBag.message
                </div>
            }

            @if (TempData["success"] != null)
            {
                <div class="alert alert-success bg-success bg-opacity-25 border-0 text-white">
                    @TempData["success"]
                </div>
            }

            <form asp-action="SignIn" method="post">

                <div class="mb-4">
                    <label class="form-label">Email Address</label>
                    <input name="customer_email"
                           class="form-control py-2"
                           placeholder="Enter your email"
                           required />
                </div>

                <div class="mb-4">
                    <label class="form-label">Password</label>
                    <input name="customer_password"
                           type="password"
                           class="form-control py-2"
                           placeholder="Enter password"
                           required />
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2">
                    Sign In
                </button>

                <div class="text-center mt-4">
                    <span style="color:#ccc;">New here?</span>
                    <a asp-action="SignUp" class="fw-semibold">Create Account</a>
                </div>

            </form>

        </div>
    </div>
</div>
