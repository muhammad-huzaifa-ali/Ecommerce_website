@{
    Layout = "~/Views/Shared/_UserAuthLayout.cshtml";
}

@model Ecommerce_website.Models.Customer

<div class="auth-card">
    <div class="card border-0">
        <div class="card-body p-5">

            <h3 class="text-center mb-4 fw-bold">
                Create Your Account
            </h3>

            @if (ViewBag.message != null)
            {
                <div class="alert alert-danger bg-danger bg-opacity-25 border-0 text-white">
                    @ViewBag.message
                </div>
            }

            <form asp-action="SignUp" method="post" enctype="multipart/form-data">

                <div class="mb-3">
                    <label>Full Name</label>
                    <input asp-for="customer_name"
                           class="form-control py-2"
                           placeholder="Enter full name"
                           required />
                </div>

                <div class="mb-3">
                    <label>Email</label>
                    <input asp-for="customer_email"
                           class="form-control py-2"
                           placeholder="Enter email"
                           required />
                </div>

                <div class="mb-3">
                    <label>Phone</label>
                    <input asp-for="customer_phone"
                           class="form-control py-2"
                           placeholder="Enter phone number"
                           required />
                </div>

                <div class="mb-3">
                    <label>Password</label>
                    <input asp-for="customer_password"
                           type="password"
                           class="form-control py-2"
                           placeholder="Create password"
                           required />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label>Country</label>
                        <input asp-for="customer_country"
                               class="form-control py-2" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>City</label>
                        <input asp-for="customer_city"
                               class="form-control py-2" />
                    </div>
                </div>

                <div class="mb-3">
                    <label>Address</label>
                    <textarea asp-for="customer_address"
                              class="form-control py-2"
                              rows="2"></textarea>
                </div>

                <div class="mb-3">
                    <label>Gender</label>
                    <select asp-for="customer_gender"
                            class="form-select py-2">
                        <option value="">Select</option>
                        <option>Male</option>
                        <option>Female</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label>Profile Image (optional)</label>
                    <input type="file"
                           name="customer_image"
                           class="form-control py-2" />
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2">
                    Sign Up
                </button>

                <div class="text-center mt-4">
                    <span style="color:#ccc;">Already registered?</span>
                    <a asp-action="SignIn" class="fw-semibold">Sign In</a>
                </div>

            </form>

        </div>
    </div>
</div>
