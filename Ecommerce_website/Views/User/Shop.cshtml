@model Ecommerce_website.Models.ShopViewModel


<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
<link rel="stylesheet" href="~/WebsiteCss/Shop.css" asp-append-version="true" />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">


<section class="shop-page container py-5">

    <!--  PAGE TITLE -->
    <div class="text-center mb-4">
        <h2 class="shop-title">OUR SHOP</h2>
        <p class="shop-sub">Premium gadgets for you</p>
    </div>

    <div class="row">

        <!-- LEFT: Categories + Sort -->
    

         <div class="col-lg-3 mb-4">

            <!-- Categories -->

            <h4>Products (@Model.TotalProducts)</h4>
            <ul class="list-group mb-3">

                @foreach (var cat in Model.Categories)
                {
                var isActive = (Model.SelectedCategoryId == cat.category_id) ? "active-category" : "";

                    <li class="list-group-item @isActive">
                        <a asp-action="Shop"
                           asp-controller="User"
                           asp-route-id="@cat.category_id"
                           asp-route-sort="@Context.Request.Query["sort"]">
                            @cat.category_name
                        </a>
                    </li>
                }
            </ul>

            <!-- Sort Dropdown -->

            <h5>Sort By</h5>

            @{
                var currentSort = Context.Request.Query["sort"].ToString();
                var currentId = Model.SelectedCategoryId;
            }

            <select class="form-select mb-3"
                    onchange="window.location.href='@Url.Action("Shop", "User")?id=@currentId&sort=' + this.value">

                <option value=""
                        selected="@(string.IsNullOrEmpty(currentSort))">
                    Default
                </option>

                <option value="latest"
                        selected="@(currentSort == "latest")">
                    Latest
                </option>

                <option value="low"
                        selected="@(currentSort == "low")">
                    Price Low → High
                </option>

                <option value="high"
                        selected="@(currentSort == "high")">
                    Price High → Low
                </option>

            </select>


            <!-- Clear Filters Button -->
            <a href="@Url.Action("Shop", "User")"
               class="clear-btn w-100 text-center text-white text-decoration-none">
                Clear Filters
            </a>


        </div> 

        <!-- RIGHT: Products -->
        <div class="col-lg-9">

            <h4>Products</h4>
            <div class="row">
                @if (!Model.Products.Any())
                {
                    <p class="text-center" style="color:#b38b00; font-weight:600;">
                        @ViewBag.EmptyMessage
                    </p>
                }
                else
                {
                    <div class="row">
                        @foreach (var prod in Model.Products)
                        {
                            <div class="col-md-4 mb-4">
                                <div class="card">
                                    <img src="~/Product_images/@prod.product_image" class="card-img-top" />
                                    <div class="card-body">
                                        <h5 class="card-title">@prod.product_name</h5>
                                        <p class="card-text">Rs @prod.product_price.ToString("N0")</p>
                                        <a href="@Url.Action("ProductDetails", "User", new { id = prod.product_id })" class="btn btn-primary">View</a>
                                    </div>
                                </div>
                            </div>
                        }

                    </div>
                }

           </div>
        </div>
    </div>

</section>

