
<head>
    <meta charset="utf-8" />
    <title>Techora</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <!-- YOUR HOME.CSS -->
    <link rel="stylesheet" href="~/WebsiteCss/About.css" asp-append-version="true" />
</head>


<!--INTRO SECTION -->
<section class="intro">
    <div class="intro-left">
        <h1>Welcome to Techora</h1>
        <p>Redefining how you experience technology. Explore premium gadgets, smart devices, and accessories curated just for you.</p>
        <a href="/User/Experience" class="vip-cta">Explore Collection</a>
    </div>

    <div class="intro-right">
        <div class="feature-card">
            <i class="fa-solid fa-truck-fast"></i>
            <h3>Fast Delivery</h3>
            <p>Get your gadgets delivered lightning-fast, anywhere.</p>
        </div>
        <div class="feature-card">
            <i class="fa-solid fa-shield-halved"></i>
            <h3>Authentic Products</h3>
            <p>100% genuine tech from trusted brands worldwide.</p>
        </div>
        <div class="feature-card">
            <i class="fa-solid fa-headset"></i>
            <h3>Premium Support</h3>
            <p>Our expert team is always ready to assist you.</p>
        </div>
    </div>
</section>


<!-- OUR MISSION -->
<section class="our-story">
    <h2>Our Mission</h2>
    <p>
        At Techora, we redefine your tech experience. We combine cutting-edge gadgets
        with exceptional service, ensuring every purchase is memorable and hassle-free.
    </p>

    <div class="usps">
        <div class="usp-card">
            <div class="usp-icon">⚡</div>
            <h3>Fast & Reliable Delivery</h3>
            <p>Lightning-fast shipping ensures your gadgets arrive safely and on time.</p>
        </div>

        <div class="usp-card">
            <div class="usp-icon">🛠️</div>
            <h3>Authentic Products</h3>
            <p>Every item is 100% genuine, sourced from trusted brands worldwide.</p>
        </div>

        <div class="usp-card">
            <div class="usp-icon">⭐</div>
            <h3>Premium Support</h3>
            <p>Our team is always ready to help, whether pre-sale or post-sale.</p>
        </div>

        <div class="usp-card">
            <div class="usp-icon">💡</div>
            <h3>Innovation First</h3>
            <p>We stay ahead of trends, offering products that make life smarter and easier.</p>
        </div>
    </div>
</section>

<!-- OUR TEAM -->
<section class="our-team">

    <h2 id="team-heading">Meet Our Team</h2>
    <p id="team-description">Our passionate team brings creativity, tech expertise, 
        and customer-first approach to every project.</p>

    <div class="team-grid">
        <div class="team-member">
            <img src="~/AboutPage_images/Huzaifa_CEO.jpg" alt="Huzaifa Ali">
            <div class="overlay">
                <h3>Huzaifa Ali</h3>
                <p>Founder & CEO – Visionary leader driving Techora's mission forward.</p>
            </div>
        </div>
        <div class="team-member">
            <img src="~/AboutPage_images/Ahmed.jpg" alt="Sarah Khan">
            <div class="overlay">
                <h3>Ahmed Khan</h3>
                <p>Head of Marketing – Crafting strategies that connect with tech lovers worldwide.</p>
            </div>
        </div>
        <div class="team-member">
            <img src="~/AboutPage_images/Our Team.jpg" alt="Our Team">
            <div class="overlay">
                <h3>Our Team</h3>
                <p>Customer Relations – Ensuring every customer feels valued and supported.</p>
            </div>
        </div>
    </div>
</section>

<!-- STATS -->
<section class="stats">
    <div class="stats-grid">
        <div class="stat-card">
            <h3 class="stat-number" data-target="500">1200+</h3>
            <p>Products Sold</p>
        </div>
        <div class="stat-card">
            <h3 class="stat-number" data-target="99"> 98%</h3>
            <p>% Customer Satisfaction</p>
        </div>
        <div class="stat-card">
            <h3 class="stat-number" data-target="100">30+</h3>
            <p>Collections  Available</p>
        </div>
        <div class="stat-card">
            <h3 class="stat-number" data-target="10">2+</h3>
            <p>Years of Expertise</p>
        </div>
    </div>
</section>

<!-- TESTIMONIALS -->
<section class="testimonials">
    <h2>What Our Customers Say</h2>
    <div class="testimonial-slider">
        <div class="testimonial-card">
            <img src="~/AboutPage_images/Customer1.png" alt="Customer">
            <p>⭐⭐⭐⭐⭐</p>
            <p>"Techora transformed my home office setup. Fast delivery and top-notch products!"</p>
        </div>
        <div class="testimonial-card">
            <img src="~/AboutPage_images/Customer2.png" alt="Customer">
            <p>⭐⭐⭐⭐⭐</p>
            <p>"Excellent customer service. They helped me choose the perfect laptop for my needs."</p>
        </div>
        <div class="testimonial-card">
            <img src="~/AboutPage_images/Customer3.png" alt="Customer">
            <p>⭐⭐⭐⭐⭐</p>
            <p>"High quality gadgets, very satisfied. I keep coming back for new tech."</p>
        </div>
        <div class="testimonial-card">
            <img src="~/AboutPage_images/Customer4.png" alt="Customer">
            <p>⭐⭐⭐⭐⭐</p>
            <p>"Amazing variety of products. Techora is now my go-to tech store!"</p>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="cta-shop">
    <h2>Ready to Upgrade Your Tech?</h2>
    <p>Discover our premium collection of gadgets, accessories, and smart devices curated just for you.</p>
    <a href="@Url.Action("Shop","User")" class="shop-cta">Shop Now</a>
</section>
