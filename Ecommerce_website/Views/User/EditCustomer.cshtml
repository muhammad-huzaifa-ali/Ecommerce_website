@model Ecommerce_website.Models.Customer
@{
    ViewData["Title"] = "Edit Profile";
}
  @* ==============  User side =====================  *@
<style>
    body {
        background: #f4f6f9;
    }

    .profile-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .profile-card {
        border-radius: 22px;
        border: none;
        background: #fff;
        max-width: 720px;
        width: 100%;
    }

    .profile-img {
        width: 150px;
        height: 150px;
        object-fit: cover;
        border-radius: 50%;
        border: 4px solid #0d6efd;
        background: #fff;
    }

    .upload-btn {
        font-size: 14px;
    }

    .section-title {
        font-size: 13px;
        letter-spacing: .7px;
        color: #6c757d;
        font-weight: 700;
        margin-top: 25px;
    }

    .form-control,
    .form-select {
        border-radius: 12px;
        padding: 10px 14px;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 .15rem rgba(13,110,253,.25);
        }

    .btn-main {
        border-radius: 14px;
        padding: 12px;
        font-weight: 600;
    }

  

</style>

<div class="container profile-wrapper">
    <div class="profile-card shadow-lg p-4 p-md-5">

        <h3 class="fw-bold text-center text-primary mb-1">Edit Profile</h3>
        <p class="text-center text-muted mb-4">
            Update your personal information
        </p>

        @* ERROR SHOW *@
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form asp-action="EditCustomer"
              asp-controller="User"
              method="post"
              enctype="multipart/form-data">

            <input type="hidden" asp-for="customer_id" />

            <!-- PROFILE IMAGE -->
            <div class="text-center mb-4">
                <img src="~/Customer_images/@Model.customer_image"
                     class="rounded-circle img-fluid d-block mx-auto
            w-50 w-sm-50 w-md-25 w-lg-25"
                     style="max-width:140px; height:auto; object-fit:cover;">


                <input type="file"
                       name="customer_image"
                       class="form-control upload-btn mx-auto"
                       style="max-width:260px;" />
            </div>

            <!-- BASIC INFO -->
            <div class="section-title">BASIC INFORMATION</div>

            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Full Name</label>
                    <input asp-for="customer_name" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Email</label>
                    <input asp-for="customer_email" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Password</label>
                    <input asp-for="customer_password" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Phone</label>
                    <input asp-for="customer_phone" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Gender</label>
                    <select asp-for="customer_gender" class="form-select">
                        <option value="">Select</option>
                        <option>Male</option>
                        <option>Female</option>
                    </select>
                </div>
            </div>

            <!-- ADDRESS -->
            <div class="section-title">ADDRESS DETAILS</div>

            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Country</label>
                    <input asp-for="customer_country" class="form-control" />
                </div>


                <div class="col-md-6">
                    <label class="form-label fw-semibold">City</label>
                    <input asp-for="customer_city" class="form-control" />
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Address</label>
                    <textarea asp-for="customer_address"
                              rows="3"
                              class="form-control"></textarea>
                </div>
            </div>

            <!-- ACTIONS -->
            <div class="d-flex flex-column flex-md-row gap-3 mt-4">
                <button type="submit"
                        class="btn btn-primary btn-main flex-fill shadow-sm">
                    Update Profile
                </button>

                <a asp-action="Profile"
                   asp-controller="User"
                   class="btn btn-outline-secondary btn-main flex-fill">
                    Cancel
                </a>
            </div>

        </form>
    </div>
</div>
