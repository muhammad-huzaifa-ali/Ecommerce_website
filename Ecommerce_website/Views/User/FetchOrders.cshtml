@model List<Ecommerce_website.Models.Order>

<div class="container py-5 fade-in">

    <div class="text-center mb-5">
        <h1 class="order-title">📦 My Orders</h1>
        <p class="text-muted fs-5">All your recent purchases</p>
    </div>

    <div class="glass-card p-4">

        <div class="table-responsive">
            <table class="table align-middle text-center">
                <thead class="table-dark">
                    <tr>
                        <th>Image</th>
                        <th>Product</th>
                        <th>Price</th>
                        <th>Qty</th>
                        <th>Date</th>
                        <th>Total</th>
                    </tr>
                </thead>

                <tbody>

                    @{
                        decimal grand = 0;
                    }

                    @foreach (var item in Model)
                    {
                        decimal price = item.product.product_price;
                        decimal total = price * item.quantity;
                        grand += total;

                        <tr>
                            <td>
                                <img src="~/Product_images/@item.product.product_image"
                                     width="70" class="product-img" />
                            </td>

                            <td class="fw-semibold">
                                @item.product.product_name
                            </td>

                            <td>Rs @price.ToString("N0")</td>

                            <td>@item.quantity</td>

                            <td>
                                @item.order_date.ToString("dd MMM yyyy")
                            </td>

                            <td class="fw-bold text-success">
                                Rs @total.ToString("N0")
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>

        <!-- GRAND TOTAL -->
        <div class="d-flex justify-content-between mt-4">
            <h4 class="fw-bold">Total Spending</h4>
            <h3 class="price-tag">Rs @grand.ToString("N0")</h3>
        </div>

    </div>
</div>


<style>
    body {
        background: linear-gradient(135deg,#eef2ff,#f8f9ff);
    }

    .order-title {
        font-size: 38px;
        font-weight: 800;
        background: linear-gradient(45deg,#ffb300,#ff6a00);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .glass-card {
        background: rgba(255,255,255,0.9);
        backdrop-filter: blur(10px);
        border-radius: 25px;
        box-shadow: 0 25px 60px rgba(0,0,0,0.15);
        transition: .4s;
    }

        .glass-card:hover {
            transform: translateY(-6px);
        }

    .product-img {
        border-radius: 12px;
        object-fit: contain;
    }

    .price-tag {
        font-size: 26px;
        font-weight: 800;
        color: #ff8800;
    }

    .fade-in {
        opacity: 0;
        transform: translateY(40px);
        animation: fadeUp .6s ease forwards;
    }

    @@keyframes fadeUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
